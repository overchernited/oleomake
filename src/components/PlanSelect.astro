---
import { Layers } from "@lucide/astro";
import Dropdown from "./Dropdown.astro";

interface PlanItem {
  value: string;
  label: string;
  icon: any;
}

const { items, placeholder, name = "plan" }: { items: PlanItem[]; placeholder: string; name?: string } = Astro.props;
---

<Dropdown
  id="plan"
  mode="select"
  items={items}
  name={name}
  placeholder={placeholder}
  icon={Layers}
  triggerClass="w-full px-4 py-3.5 rounded-xl bg-white/5 border border-purple-400/20 text-purple-200/60 text-[0.95rem] hover:border-purple-400 focus:border-purple-400 focus:shadow-[0_0_0_3px_rgba(139,26,255,0.15)]"
  menuClass="left-0 right-0"
  itemClass="text-purple-200/70 hover:bg-purple-500/10"
/>
