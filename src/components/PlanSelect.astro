---
import { Layers, ChevronDown } from "@lucide/astro";

interface PlanItem {
  value: string;
  label: string;
  icon: any;
}

const { items, placeholder, name = "plan" }: { items: PlanItem[]; placeholder: string; name?: string } = Astro.props;
---

<div class="relative plan-select">
  <input type="hidden" name={name} id="planValue" value="" />
  <button type="button" id="planTrigger" class="w-full flex items-center gap-3 px-4 py-3.5 rounded-xl bg-white/5 border border-purple-400/20 text-purple-200/60 text-[0.95rem] text-left outline-none transition-all duration-300 cursor-pointer hover:border-purple-400 focus:border-purple-400 focus:shadow-[0_0_0_3px_rgba(139,26,255,0.15)]">
    <Layers class="text-purple-400/50 shrink-0" size={18} />
    <span id="planText" class="text-white/30">{placeholder}</span>
    <ChevronDown class="ml-auto text-purple-400/50 shrink-0 transition-transform duration-200" id="planChevron" size={18} />
  </button>
  <div id="planDropdown" class="dropdown-hidden absolute top-full left-0 right-0 mt-1.5 z-10 bg-[rgba(11,13,20,0.97)] backdrop-blur-2xl border border-purple-500/20 rounded-xl shadow-[0_8px_32px_rgba(0,0,0,0.5)] py-1 transition-all duration-200">
    {items.map((item) => {
      const Icon = item.icon;
      return (
        <button type="button" data-value={item.value} class="option-btn w-full flex items-center gap-3 px-4 py-2.5 text-sm text-purple-200/70 transition-colors duration-200 hover:text-white hover:bg-purple-500/10 cursor-pointer bg-transparent border-none text-left">
          <Icon class="text-purple-400 shrink-0" size={16} />
          <span>{item.label}</span>
        </button>
      );
    })}
  </div>
</div>

<script>
  const trigger = document.getElementById("planTrigger");
  const menu = document.getElementById("planDropdown");
  const chevron = document.getElementById("planChevron");
  const value = document.getElementById("planValue");
  const text = document.getElementById("planText");

  function close() {
    menu?.classList.add("dropdown-hidden");
    chevron?.classList.remove("rotate-180");
  }

  function open() {
    menu?.classList.remove("dropdown-hidden");
    chevron?.classList.add("rotate-180");
  }

  trigger?.addEventListener("click", (e) => {
    e.stopPropagation();
    menu?.classList.contains("dropdown-hidden") ? open() : close();
  });

  document.querySelectorAll(".option-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const val = btn.getAttribute("data-value");
      const label = btn.querySelector("span")?.textContent || "";
      if (value) value.value = val;
      if (text) {
        text.textContent = label;
        text.className = "text-white";
      }
      close();
      trigger?.focus();
    });
  });

  document.addEventListener("click", () => {
    if (!menu?.classList.contains("dropdown-hidden")) close();
  });
</script>
