---
import { Languages, ChevronDown } from "@lucide/astro";
import { getLocale } from "../i18n";
const locale = getLocale(Astro.url.pathname);
---

<div class="relative">
  <button id="langTrigger" class="flex items-center gap-1.5 text-sm text-purple-300 font-semibold px-3 py-1.5 rounded-lg border border-purple-400/30 hover:bg-purple-500/15 transition-all duration-300 cursor-pointer bg-transparent">
    <Languages class="text-purple-400" size={16} />
    <span>{locale.toUpperCase()}</span>
    <ChevronDown class="w-3 h-3 transition-transform duration-200" id="langChevron" />
  </button>
  <div id="langDropdown" class="dropdown-hidden absolute top-full left-0 mt-1.5 min-w-[140px] bg-[rgba(11,13,20,0.95)] backdrop-blur-2xl border border-purple-500/20 rounded-xl shadow-[0_8px_32px_rgba(0,0,0,0.5)] py-1 transition-all duration-200">
    <a href="/" class="flex items-center gap-2 px-3 py-2 text-sm text-purple-200/70 no-underline transition-colors duration-200 hover:text-white hover:bg-purple-500/15 rounded-lg mx-1 {locale === 'es' ? 'text-white font-semibold bg-purple-500/15' : ''}">
      <span class="text-base leading-none">🇪🇸</span> Español
    </a>
    <a href="/en/" class="flex items-center gap-2 px-3 py-2 text-sm text-purple-200/70 no-underline transition-colors duration-200 hover:text-white hover:bg-purple-500/15 rounded-lg mx-1 {locale === 'en' ? 'text-white font-semibold bg-purple-500/15' : ''}">
      <span class="text-base leading-none">🇺🇸</span> English
    </a>
  </div>
</div>

<script>
  const trigger = document.getElementById("langTrigger");
  const menu = document.getElementById("langDropdown");
  const chevron = document.getElementById("langChevron");
  trigger?.addEventListener("click", (e) => {
    e.stopPropagation();
    menu?.classList.toggle("dropdown-hidden");
    chevron?.classList.toggle("rotate-180");
  });
  document.addEventListener("click", () => {
    if (!menu?.classList.contains("dropdown-hidden")) {
      menu?.classList.add("dropdown-hidden");
      chevron?.classList.remove("rotate-180");
    }
  });
</script>
