---
import { Languages } from "@lucide/astro";
import Dropdown from "./Dropdown.astro";
import { getLocale } from "../i18n";
const locale = getLocale(Astro.url.pathname);

const items = [
  { value: "es", label: "Español", href: "/", iconText: "🇪🇸" },
  { value: "en", label: "English", href: "/en/", iconText: "🇺🇸" },
];
---

<Dropdown
  id="lang"
  mode="link"
  items={items}
  selected={locale}
  icon={Languages}
  triggerLabel={locale.toUpperCase()}
  triggerClass="text-sm text-purple-300 font-semibold px-3 py-1.5 rounded-lg border border-purple-400/30 hover:bg-purple-500/15 bg-transparent"
  menuClass="min-w-[140px] left-0"
/>
