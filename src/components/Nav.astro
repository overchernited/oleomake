---
import { getLocale, getTranslations } from "../i18n";
import { Home, Briefcase, Mail, MessageCircleWarning } from "@lucide/astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-[rgba(11,13,20,0.92)] backdrop-blur-2xl border-b border-purple-500/20 shadow-[0_4px_30px_rgba(147,51,234,0.1)]">
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-16">
    <div class="flex items-center gap-4">
      <a href={locale === "es" ? "/" : "/en/"} class="flex items-center gap-2 no-underline">
        <span class="text-2xl text-purple-400 font-extrabold">◆</span>
        <span class="text-xl font-extrabold text-white">Oleo<span class="text-purple-400">Make</span></span>
      </a>
      <LanguageSwitcher />
    </div>
    <div class="flex items-center gap-4">
      <button class="menu-toggle flex md:hidden flex-col gap-1.5 bg-transparent border-none cursor-pointer p-1" id="menuToggle" aria-label="Menú">
        <span class="block w-6 h-0.5 bg-white rounded transition-all duration-300"></span>
        <span class="block w-6 h-0.5 bg-white rounded transition-all duration-300"></span>
        <span class="block w-6 h-0.5 bg-white rounded transition-all duration-300"></span>
      </button>
    </div>
    <div class="nav-links md:flex items-center gap-2" id="navLinks">
      <a href={locale === "es" ? "#inicio" : "#inicio"} class="nav-link flex items-center gap-2">
        <Home size={16} />
        <span>{t.nav.inicio}</span>
      </a>
      <a href={locale === "es" ? "#servicios" : "#servicios"} class="nav-link flex items-center gap-2">
        <Briefcase size={16} />
        <span>{t.nav.servicios}</span>
      </a>
      <a href={locale === "es" ? "#contacto" : "#contacto"} class="nav-link flex items-center gap-2">
        <Mail size={16} />
        <span>{t.nav.contacto}</span>
      </a>
      <a href="https://wa.me/573502815267" target="_blank" rel="noopener" class="btn-shine glow-pulse inline-flex items-center gap-2 px-5 py-2.5 bg-linear-to-br from-purple-600 to-purple-500 text-white no-underline rounded-lg font-semibold text-[0.95rem] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_4px_20px_rgba(139,26,255,0.4)]">
        <MessageCircleWarning size={18} />
        <span>{t.nav.whatsapp}</span>
      </a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById("menuToggle");
  const links = document.getElementById("navLinks");
  toggle?.addEventListener("click", () => {
    links?.classList.toggle("active");
    toggle.classList.toggle("open");
  });
  document.querySelectorAll(".nav-links a").forEach((link) => {
    link.addEventListener("click", () => {
      links?.classList.remove("active");
      toggle?.classList.remove("open");
    });
  });
</script>

<style>
  .menu-toggle.open span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
  .menu-toggle.open span:nth-child(2) { opacity: 0; }
  .menu-toggle.open span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }
  .nav-link {
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    color: rgba(243, 237, 255, 0.75);
    transition: all 0.3s;
  }
  .nav-link:hover {
    color: #fff;
    background: rgba(168, 85, 247, 0.1);
  }
  @media (max-width: 767px) {
    .nav-links {
      display: flex !important;
      flex-direction: column;
      position: fixed;
      top: 64px;
      left: 0;
      right: 0;
      gap: 0;
      background: rgba(11, 13, 20, 0.97);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      padding: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
      border-bottom: 1px solid rgba(168, 85, 247, 0.2);
    }
    .nav-links.active { max-height: 300px; padding: 0.5rem 0; }
    .nav-links a { padding: 0.875rem 1.5rem; width: 100%; text-align: center; justify-content: center; }
    .nav-links a:last-child { margin: 0.5rem 1.5rem; text-align: center; width: auto; }
  }
</style>
