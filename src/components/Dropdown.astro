---
import { ChevronDown } from "@lucide/astro";

interface Item {
  value: string;
  label: string;
  icon?: any;
  iconText?: string;
  href?: string;
}

interface Props {
  id: string;
  items: Item[];
  mode: "link" | "select";
  name?: string;
  placeholder?: string;
  selected?: string;
  triggerLabel?: string;
  triggerClass?: string;
  menuClass?: string;
  itemClass?: string;
  icon?: any;
}

const {
  id, items, mode, name, placeholder, selected,
  triggerLabel, triggerClass = "", menuClass = "", itemClass = "",
  icon: TriggerIcon,
} = Astro.props;

const tid = `${id}T`;
const mid = `${id}M`;
const cid = `${id}C`;
const vid = `${id}V`;
const xid = `${id}X`;
const hids = items.map((_, i) => `${id}H${i}`);
---

<div class="relative">
  {mode === "select" && <input type="hidden" name={name || id} id={vid} value="" />}
  <button type="button" id={tid}
    class={"flex items-center gap-2 text-left outline-none transition-all duration-300 cursor-pointer " + triggerClass}>
    {TriggerIcon && <TriggerIcon class="shrink-0" size={18} />}
    {mode === "select"
      ? <span id={xid} class="text-white/30">{placeholder}</span>
      : <span>{triggerLabel}</span>
    }
    <ChevronDown id={cid} class="shrink-0 transition-transform duration-200" size={18} />
  </button>
  <div id={mid} class={"dropdown-hidden absolute top-full mt-1.5 z-10 bg-[rgba(11,13,20,0.97)] backdrop-blur-2xl border border-purple-500/20 rounded-xl shadow-[0_8px_32px_rgba(0,0,0,0.5)] py-1 transition-all duration-200 " + menuClass}>
    {items.map((item, i) => {
      const Icon = item.icon;
      return mode === "link" ? (
        <a href={item.href || "#"}
          class={"flex items-center gap-2 px-3 py-2 text-sm no-underline transition-colors duration-200 hover:text-white hover:bg-purple-500/15 rounded-lg mx-1 " + (item.value === selected ? "text-white font-semibold bg-purple-500/15" : "text-purple-200/70") + " " + itemClass}
          id={hids[i]}>
          {item.iconText
            ? <span class="text-base leading-none">{item.iconText}</span>
            : Icon ? <Icon class="shrink-0" size={16} /> : null
          }
          <span>{item.label}</span>
        </a>
      ) : (
        <button type="button" data-value={item.value}
          class={"option-btn w-full flex items-center gap-3 px-4 py-2.5 text-sm transition-colors duration-200 hover:text-white hover:bg-purple-500/10 cursor-pointer bg-transparent border-none text-left " + itemClass}>
          {Icon && <Icon class="text-purple-400 shrink-0" size={16} />}
          <span>{item.label}</span>
        </button>
      );
    })}
  </div>
</div>

<script>
  (function (d, id, mode) {
    var trigger = d.getElementById(id + "T");
    var menu = d.getElementById(id + "M");
    var chevron = d.getElementById(id + "C");
    if (!trigger || !menu) return;

    function close() { menu.classList.add("dropdown-hidden"); chevron?.classList.remove("rotate-180"); }
    function open() { menu.classList.remove("dropdown-hidden"); chevron?.classList.add("rotate-180"); }

    trigger.addEventListener("click", function (e) {
      e.stopPropagation();
      menu.classList.contains("dropdown-hidden") ? open() : close();
    });

    d.addEventListener("click", function () {
      if (!menu.classList.contains("dropdown-hidden")) close();
    });

    if (mode === "select") {
      var valueInput = d.getElementById(id + "V");
      var textSpan = d.getElementById(id + "X");
      d.querySelectorAll("#" + id + "M .option-btn").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var val = btn.getAttribute("data-value");
          var label = (btn.querySelector("span")?.textContent || "");
          if (valueInput) valueInput.value = val;
          if (textSpan) { textSpan.textContent = label; textSpan.className = "text-white"; }
          close();
          trigger?.focus();
        });
      });
    }
  })(document, "{id}", "{mode}");
</script>
