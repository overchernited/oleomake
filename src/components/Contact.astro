---
import { getLocale, getTranslations } from "../i18n";
import { MessageSquare, Mail, MapPin, User, Layers, ChevronDown, Rocket, Crown, Building, Send } from "@lucide/astro";
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
---

<section class="py-24 relative" id="contacto">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <div class="contact-info">
        <h2 class="text-white font-extrabold mb-4 text-left" style="font-size: clamp(2rem, 5vw, 3rem);">
          {t.contact.title} <span class="bg-gradient-to-br from-purple-400 to-blue-400 bg-clip-text text-transparent">{t.contact.titleAccent}</span>
        </h2>
        <p class="text-lg text-purple-200/60 leading-relaxed mb-10">
          {t.contact.desc}
        </p>
        <div class="flex flex-col gap-4">
          <a href="https://wa.me/573502815267" target="_blank" rel="noopener" class="flex items-center gap-4 p-4 pr-6 rounded-xl glass no-underline transition-all duration-300 hover:border-purple-400 hover:translate-x-1">
            <div class="w-10 h-10 rounded-lg bg-purple-500/15 flex items-center justify-center shrink-0">
              <MessageSquare class="text-purple-400" size={20} />
            </div>
            <div>
              <span class="block text-xs text-purple-200/60">{t.contact.whatsapp}</span>
              <span class="block text-[0.95rem] text-white font-medium">{t.contact.phone}</span>
            </div>
          </a>
          <div class="flex items-center gap-4 p-4 pr-6 rounded-xl glass transition-all duration-300 hover:border-purple-400 hover:translate-x-1">
            <div class="w-10 h-10 rounded-lg bg-purple-500/15 flex items-center justify-center shrink-0">
              <Mail class="text-purple-400" size={20} />
            </div>
            <div>
              <span class="block text-xs text-purple-200/60">Email</span>
              <span class="block text-[0.95rem] text-white font-medium">{t.contact.email}</span>
            </div>
          </div>
          <div class="flex items-center gap-4 p-4 pr-6 rounded-xl glass transition-all duration-300 hover:border-purple-400 hover:translate-x-1">
            <div class="w-10 h-10 rounded-lg bg-purple-500/15 flex items-center justify-center shrink-0">
              <MapPin class="text-purple-400" size={20} />
            </div>
            <div>
              <span class="block text-xs text-purple-200/60">{t.contact.ubicacion}</span>
              <span class="block text-[0.95rem] text-white font-medium">{t.contact.colombia}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-card p-10 rounded-2xl glass relative overflow-hidden">
        <div class="absolute top-[-50%] left-[-50%] w-[200%] h-[200%] bg-[radial-gradient(circle,rgba(162,77,255,0.05)_0%,transparent_70%)] pointer-events-none"></div>
        <h3 class="text-xl font-bold text-white mb-2">{t.contact.cardTitle}</h3>
        <p class="text-sm text-purple-200/60 mb-8">{t.contact.cardDesc}</p>
        <form class="flex flex-col gap-4" id="contactForm">
          <div class="relative">
            <User class="absolute left-4 top-1/2 -translate-y-1/2 text-purple-400/50 pointer-events-none" size={18} />
            <input type="text" placeholder={t.contact.formName} required class="w-full pl-11 pr-5 py-3.5 rounded-xl bg-white/5 border border-purple-400/20 text-white text-[0.95rem] outline-none transition-all duration-300 placeholder:text-white/30 focus:border-purple-400 focus:bg-white/8 focus:shadow-[0_0_0_3px_rgba(139,26,255,0.15)]" />
          </div>
          <div class="relative">
            <Mail class="absolute left-4 top-1/2 -translate-y-1/2 text-purple-400/50 pointer-events-none" size={18} />
            <input type="email" placeholder={t.contact.formEmail} required class="w-full pl-11 pr-5 py-3.5 rounded-xl bg-white/5 border border-purple-400/20 text-white text-[0.95rem] outline-none transition-all duration-300 placeholder:text-white/30 focus:border-purple-400 focus:bg-white/8 focus:shadow-[0_0_0_3px_rgba(139,26,255,0.15)]" />
          </div>

          <div class="relative" id="planSelect">
            <input type="hidden" name="plan" id="planValue" value="" />
            <button type="button" id="planTrigger" class="w-full flex items-center gap-3 px-4 py-3.5 rounded-xl bg-white/5 border border-purple-400/20 text-purple-200/60 text-[0.95rem] text-left outline-none transition-all duration-300 cursor-pointer hover:border-purple-400 focus:border-purple-400 focus:shadow-[0_0_0_3px_rgba(139,26,255,0.15)]">
              <Layers class="text-purple-400/50 shrink-0" size={18} />
              <span id="planText" class="text-white/30">{t.contact.formPlan}</span>
              <ChevronDown class="ml-auto text-purple-400/50 shrink-0 transition-transform duration-200" id="planChevron" size={18} />
            </button>
            <div id="planDropdown" class="absolute top-full left-0 right-0 mt-1.5 z-10 bg-[rgba(11,13,20,0.97)] backdrop-blur-2xl border border-purple-500/20 rounded-xl shadow-[0_8px_32px_rgba(0,0,0,0.5)] py-1 opacity-0 invisible translate-y-1 transition-all duration-200">
              <button type="button" data-value="basico" class="option-btn w-full flex items-center gap-3 px-4 py-2.5 text-sm text-purple-200/70 transition-colors duration-200 hover:text-white hover:bg-purple-500/10 cursor-pointer bg-transparent border-none text-left">
                <Rocket class="text-purple-400" size={16} />
                <span>{t.contact.formPlanB}</span>
              </button>
              <button type="button" data-value="profesional" class="option-btn w-full flex items-center gap-3 px-4 py-2.5 text-sm text-purple-200/70 transition-colors duration-200 hover:text-white hover:bg-purple-500/10 cursor-pointer bg-transparent border-none text-left">
                <Crown class="text-purple-400" size={16} />
                <span>{t.contact.formPlanP}</span>
              </button>
              <button type="button" data-value="empresarial" class="option-btn w-full flex items-center gap-3 px-4 py-2.5 text-sm text-purple-200/70 transition-colors duration-200 hover:text-white hover:bg-purple-500/10 cursor-pointer bg-transparent border-none text-left">
                <Building class="text-purple-400" size={16} />
                <span>{t.contact.formPlanE}</span>
              </button>
            </div>
          </div>

          <div class="relative">
            <MessageSquare class="absolute left-4 top-4 text-purple-400/50 pointer-events-none" size={18} />
            <textarea placeholder={t.contact.formMsg} rows="4" class="w-full pl-11 pr-5 py-3.5 rounded-xl bg-white/5 border border-purple-400/20 text-white text-[0.95rem] outline-none transition-all duration-300 placeholder:text-white/30 focus:border-purple-400 focus:bg-white/8 focus:shadow-[0_0_0_3px_rgba(139,26,255,0.15)] resize-y min-h-[100px]"></textarea>
          </div>
          <button type="submit" class="inline-flex items-center justify-center gap-2.5 px-8 py-3.5 bg-gradient-to-br from-purple-600 to-purple-500 text-white no-underline rounded-xl font-semibold text-base transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_32px_rgba(139,26,255,0.3)] cursor-pointer border-none">
            <Send size={18} />
            <span>{t.contact.formBtn}</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById("contactForm")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const name = e.target.querySelector('input[type="text"]').value;
    const message = e.target.querySelector("textarea").value;
    const plan = document.getElementById("planValue")?.value || "";
    const planText = plan ? document.querySelector(`[data-value="${plan}"] span`)?.textContent || "" : "";
    const text = `Hola! Soy ${name}. ${plan ? `Me interesa ${planText}. ` : ""}${message ? `Mi proyecto: ${message}` : "Quiero una cotización"}`;
    window.open(`https://wa.me/573502815267?text=${encodeURIComponent(text)}`, "_blank");
  });

  const planTrigger = document.getElementById("planTrigger");
  const planDropdown = document.getElementById("planDropdown");
  const planValue = document.getElementById("planValue");
  const planText = document.getElementById("planText");

  planTrigger?.addEventListener("click", (e) => {
    e.stopPropagation();
    planDropdown?.classList.toggle("opacity-0");
    planDropdown?.classList.toggle("invisible");
    planDropdown?.classList.toggle("translate-y-1");
    planDropdown?.classList.toggle("opacity-100");
    planDropdown?.classList.toggle("visible");
    planDropdown?.classList.toggle("translate-y-0");
    planTrigger.querySelector("svg:last-child")?.classList.toggle("rotate-180");
  });

  document.querySelectorAll(".option-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const val = btn.getAttribute("data-value");
      const label = btn.querySelector("span")?.textContent || "";
      planValue.value = val;
      planText.textContent = label;
      planText.className = "text-white";
      planDropdown?.classList.add("opacity-0", "invisible", "translate-y-1");
      planDropdown?.classList.remove("opacity-100", "visible", "translate-y-0");
      planTrigger.querySelector("svg:last-child")?.classList.remove("rotate-180");
      planTrigger.focus();
    });
  });

  document.addEventListener("click", () => {
    if (planDropdown?.classList.contains("opacity-100")) {
      planDropdown.classList.add("opacity-0", "invisible", "translate-y-1");
      planDropdown.classList.remove("opacity-100", "visible", "translate-y-0");
      planTrigger.querySelector("svg:last-child")?.classList.remove("rotate-180");
    }
  });
</script>

<style>
  .contact-info, .contact-card { opacity: 0; }
</style>
