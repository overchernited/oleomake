---
import { getLocale, getTranslations } from "../i18n";
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
---

<section class="py-24 relative" id="contacto">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <div class="contact-info">
        <h2 class="text-white font-extrabold mb-4 text-left" style="font-size: clamp(2rem, 5vw, 3rem);">
          {t.contact.title} <span class="bg-gradient-to-br from-purple-400 to-blue-400 bg-clip-text text-transparent">{t.contact.titleAccent}</span>
        </h2>
        <p class="text-lg text-purple-200/60 leading-relaxed mb-10">
          {t.contact.desc}
        </p>
        <div class="flex flex-col gap-4">
          <a href="https://wa.me/573502815267" target="_blank" rel="noopener" class="flex items-center gap-4 p-4 pr-6 rounded-xl glass no-underline transition-all duration-300 hover:border-purple-400 hover:translate-x-1">
            <span class="text-2xl shrink-0">📱</span>
            <div>
              <span class="block text-xs text-purple-200/60">{t.contact.whatsapp}</span>
              <span class="block text-[0.95rem] text-white font-medium">{t.contact.phone}</span>
            </div>
          </a>
          <div class="flex items-center gap-4 p-4 pr-6 rounded-xl glass transition-all duration-300 hover:border-purple-400 hover:translate-x-1">
            <span class="text-2xl shrink-0">📧</span>
            <div>
              <span class="block text-xs text-purple-200/60">Email</span>
              <span class="block text-[0.95rem] text-white font-medium">{t.contact.email}</span>
            </div>
          </div>
          <div class="flex items-center gap-4 p-4 pr-6 rounded-xl glass transition-all duration-300 hover:border-purple-400 hover:translate-x-1">
            <span class="text-2xl shrink-0">🌐</span>
            <div>
              <span class="block text-xs text-purple-200/60">{t.contact.ubicacion}</span>
              <span class="block text-[0.95rem] text-white font-medium">{t.contact.colombia}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-card p-10 rounded-2xl glass relative overflow-hidden">
        <div class="absolute top-[-50%] left-[-50%] w-[200%] h-[200%] bg-[radial-gradient(circle,rgba(162,77,255,0.05)_0%,transparent_70%)] pointer-events-none"></div>
        <h3 class="text-xl font-bold text-white mb-2">{t.contact.cardTitle}</h3>
        <p class="text-sm text-purple-200/60 mb-8">{t.contact.cardDesc}</p>
        <form class="flex flex-col gap-4" id="contactForm">
          <input type="text" placeholder={t.contact.formName} required class="w-full px-5 py-3.5 rounded-xl bg-white/5 border border-purple-400/20 text-white text-[0.95rem] outline-none transition-all duration-300 placeholder:text-white/30 focus:border-purple-400 focus:bg-white/8 focus:shadow-[0_0_0_3px_rgba(139,26,255,0.15)]" />
          <input type="email" placeholder={t.contact.formEmail} required class="w-full px-5 py-3.5 rounded-xl bg-white/5 border border-purple-400/20 text-white text-[0.95rem] outline-none transition-all duration-300 placeholder:text-white/30 focus:border-purple-400 focus:bg-white/8 focus:shadow-[0_0_0_3px_rgba(139,26,255,0.15)]" />
          <select required class="w-full px-5 py-3.5 rounded-xl bg-white/5 border border-purple-400/20 text-white text-[0.95rem] outline-none transition-all duration-300 focus:border-purple-400 focus:shadow-[0_0_0_3px_rgba(139,26,255,0.15)]">
            <option value="" class="bg-dark-900 text-white">{t.contact.formPlan}</option>
            <option value="basico" class="bg-dark-900 text-white">{t.contact.formPlanB}</option>
            <option value="profesional" class="bg-dark-900 text-white">{t.contact.formPlanP}</option>
            <option value="empresarial" class="bg-dark-900 text-white">{t.contact.formPlanE}</option>
          </select>
          <textarea placeholder={t.contact.formMsg} rows="4" class="w-full px-5 py-3.5 rounded-xl bg-white/5 border border-purple-400/20 text-white text-[0.95rem] outline-none transition-all duration-300 placeholder:text-white/30 focus:border-purple-400 focus:bg-white/8 focus:shadow-[0_0_0_3px_rgba(139,26,255,0.15)] resize-y min-h-[100px]"></textarea>
          <button type="submit" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-gradient-to-br from-purple-600 to-purple-500 text-white no-underline rounded-xl font-semibold text-base transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_32px_rgba(139,26,255,0.3)] cursor-pointer border-none">
            <span>{t.contact.formBtn}</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById("contactForm")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const name = e.target.querySelector('input[type="text"]').value;
    const message = e.target.querySelector("textarea").value;
    const plan = e.target.querySelector("select").value;
    const text = `Hola! Soy ${name}. ${plan ? `Me interesa el ${plan}. ` : ""}${message ? `Mi proyecto: ${message}` : "Quiero una cotización"}`;
    window.open(`https://wa.me/573502815267?text=${encodeURIComponent(text)}`, "_blank");
  });
</script>

<style>
  .contact-info, .contact-card { opacity: 0; }
</style>
