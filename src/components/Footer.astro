---
import { getLocale, getTranslations } from "../i18n";
import { MessageCircle, Mail, MapPin, ArrowUp } from "@lucide/astro";
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
---

<footer class="footer py-20 relative border-t border-purple-500/10 overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_0%,rgba(124,58,237,0.06),transparent)] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-[1.8fr_1fr_1fr] gap-12 mb-16">
      <div>
        <a href={locale === "en" ? "/en/" : "/"} class="flex items-center gap-2 no-underline group">
          <span class="text-2xl text-purple-400 font-extrabold group-hover:scale-110 transition-transform duration-300">◆</span>
          <span class="text-xl font-extrabold text-white">Oleo<span class="text-purple-400">Make</span></span>
        </a>
        <p class="text-sm text-purple-300/50 leading-relaxed mt-4 max-w-[320px]">
          {t.footer.desc}
        </p>
        <div class="flex gap-3 mt-6">
          <a href="https://wa.me/573502815267" target="_blank" rel="noopener" aria-label="WhatsApp" class="w-9 h-9 rounded-lg bg-purple-500/10 flex items-center justify-center text-purple-400 no-underline transition-all duration-300 hover:bg-purple-500/25 hover:scale-110 hover:-translate-y-0.5">
            <MessageCircle size={18} />
          </a>
          <a href="mailto:oleomake@gmail.com" aria-label="Email" class="w-9 h-9 rounded-lg bg-purple-500/10 flex items-center justify-center text-purple-400 no-underline transition-all duration-300 hover:bg-purple-500/25 hover:scale-110 hover:-translate-y-0.5">
            <Mail size={18} />
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-sm font-bold text-white/80 uppercase tracking-widest mb-6">{t.footer.nav}</h4>
        <div class="flex flex-col gap-3">
          <a href={locale === "en" ? "/en/#hero" : "#inicio"} class="text-sm text-purple-300/50 no-underline transition-all duration-300 hover:text-purple-300 hover:translate-x-1 inline-block">{t.footer.navHome}</a>
          <a href={locale === "en" ? "/en/#services" : "#servicios"} class="text-sm text-purple-300/50 no-underline transition-all duration-300 hover:text-purple-300 hover:translate-x-1 inline-block">{t.footer.navServices}</a>
          <a href={locale === "en" ? "/en/#contacto" : "#contacto"} class="text-sm text-purple-300/50 no-underline transition-all duration-300 hover:text-purple-300 hover:translate-x-1 inline-block">{t.footer.navContact}</a>
        </div>
      </div>

      <div>
        <h4 class="text-sm font-bold text-white/80 uppercase tracking-widest mb-6">{t.footer.contact}</h4>
        <div class="flex flex-col gap-3">
          <a href="https://wa.me/573502815267" target="_blank" rel="noopener" class="flex items-center gap-2 text-sm text-purple-300/50 no-underline transition-all duration-300 hover:text-purple-300 hover:translate-x-1">
            <MessageCircle size={14} class="shrink-0" />
            <span>{t.footer.whatsapp}</span>
          </a>
          <div class="flex items-center gap-2 text-sm text-purple-300/50">
            <Mail size={14} class="shrink-0" />
            <span>{t.footer.email}</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-purple-300/50">
            <MapPin size={14} class="shrink-0" />
            <span>{t.footer.country}</span>
          </div>
        </div>
      </div>

    </div>

    <div class="flex flex-col md:flex-row items-center justify-between pt-8 border-t border-purple-500/10 text-sm text-purple-300/40">
      <p>&copy; {new Date().getFullYear()} OleoMake. {t.footer.copyright}</p>
      <button onclick="window.scrollTo({top:0,behavior:'smooth'})" class="mt-4 md:mt-0 inline-flex items-center gap-1.5 text-purple-400 bg-transparent border-none cursor-pointer text-sm transition-all duration-300 hover:text-purple-300 hover:gap-2.5">
        <span>Back to top</span>
        <ArrowUp size={14} />
      </button>
    </div>
  </div>
</footer>

<style>
  .footer { opacity: 0; }
</style>
