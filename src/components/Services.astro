---
import { getLocale, getTranslations } from "../i18n";
import { Rocket, Crown, Building } from "@lucide/astro";
import PlanCard from "./PlanCard.astro";
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
const servicesId = locale === "es" ? "#servicios" : "#servicios";
---

<section class="py-24 relative bg-dark-900 border-t border-b border-[rgba(148,139,165,0.06)]" id={servicesId.replace("#", "")}>
  <div class="blob blob-3 parallax" data-depth="15"></div>
  <div class="max-w-6xl mx-auto px-6 relative z-10">
    <h2 class="text-center text-white font-extrabold mb-4" style="font-size: clamp(2rem, 5vw, 3rem);">
      {t.services.title} <span class="bg-linear-to-br from-purple-400 to-blue-400 bg-clip-text text-transparent">{t.services.titleAccent}</span>
    </h2>
    <p class="text-center text-purple-200/60 max-w-[600px] mx-auto mb-16" style="font-size: clamp(1rem, 2vw, 1.125rem);">
      {t.services.subtitle}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10 max-w-[400px] md:max-w-none mx-auto">
      <PlanCard
        icon={Rocket}
        name={t.services.basico.name}
        desc={t.services.basico.desc}
        price={t.services.basico.price}
        features={t.services.basico.features}
        wa={t.services.basico.wa}
        btn={t.services.basico.btn}
      />
      <PlanCard
        icon={Crown}
        name={t.services.profesional.name}
        desc={t.services.profesional.desc}
        price={t.services.profesional.price}
        features={t.services.profesional.features}
        wa={t.services.profesional.wa}
        btn={t.services.profesional.btn}
        badge={t.services.profesional.badge}
        featured
      />
      <PlanCard
        icon={Building}
        name={t.services.empresarial.name}
        desc={t.services.empresarial.desc}
        price={t.services.empresarial.price}
        features={t.services.empresarial.features}
        wa={t.services.empresarial.wa}
        btn={t.services.empresarial.btn}
      />
    </div>
  </div>
</section>

<style>
  .plan-card { opacity: 0; }
  @media (max-width: 767px) {
    .plan-card.scale-\[1\.05\] { transform: none !important; }
  }
</style>
