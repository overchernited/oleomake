---
import { Check, MessageCircleWarning, Sparkles } from "@lucide/astro";

interface Props {
  icon: any;
  name: string;
  desc: string;
  price: string;
  features: string[];
  wa: string;
  btn: string;
  badge?: string;
  featured?: boolean;
}

const { icon: Icon, name, desc, price, features, wa, btn, badge, featured } = Astro.props;
---

<div class={"plan-card flex flex-col items-center text-center p-10 rounded-2xl transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_60px_rgba(99,102,241,0.08)] " + (featured
  ? "border border-purple-400/25 bg-purple-500/10 backdrop-blur-xl hover:border-purple-400/40 scale-[1.05]"
  : "bg-white/5 backdrop-blur-xl border border-white/10 hover:border-purple-400/25"
)}>
  {badge && (
    <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-5 py-1.5 rounded-full text-xs font-bold text-white bg-linear-to-br from-purple-600 to-blue-500 whitespace-nowrap inline-flex items-center gap-1.5">
      <Sparkles size={14} />
      {badge}
    </div>
  )}
  <div class={"w-14 h-14 rounded-xl flex items-center justify-center mb-4 " + (badge ? "mt-2 bg-purple-500/20" : "bg-purple-500/15")}>
    <Icon class={featured ? "text-purple-300" : "text-purple-400"} size={28} />
  </div>
  <h3 class="text-xl font-bold text-white mb-2">{name}</h3>
  <p class="text-sm text-purple-200/60 mb-6">{desc}</p>
  <div class="mb-6">
    <span class="font-code text-3xl font-extrabold bg-linear-to-br from-purple-400 to-blue-400 bg-clip-text text-transparent">{price}</span>
  </div>
  <ul class="w-full mb-8 flex-1 space-y-0">
    {features.map((f: string) => (
      <li class="py-3 text-sm text-purple-200/60 border-b border-[rgba(148,139,165,0.1)] flex items-center gap-2">
        <Check class="text-purple-400 shrink-0" size={14} />
        {f}
      </li>
    ))}
  </ul>
  <a href={`https://wa.me/573502815267?text=${wa}`} target="_blank" rel="noopener" class="btn-shine inline-flex items-center justify-center gap-2 w-full px-8 py-3.5 bg-linear-to-br from-purple-600 to-purple-500 text-white no-underline rounded-xl font-semibold text-base transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_32px_rgba(139,26,255,0.3)]">
    <MessageCircleWarning size={18} />
    <span>{btn}</span>
  </a>
</div>
