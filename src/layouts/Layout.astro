---
import "../styles/global.css";
import { getLocale, getTranslations } from "../i18n";
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
export interface Props {
  title?: string;
}
const title = Astro.props.title || (locale === "en" ? "OleoMake - Software Solutions" : "OleoMake - Soluciones de Software");
const desc = locale === "en"
  ? "OleoMake - Software solutions and web development. Plans from $500.000. We build web apps and software for your business."
  : "OleoMake - Soluciones de software y desarrollo web. Planes desde $500.000. Creamos web apps y software para tu negocio.";
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={desc} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <style>
      html.lenis { scroll-behavior: auto; }
      .lenis-smooth { scroll-behavior: auto; }
      html.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
    </style>
  </head>
  <body class="relative">
    <slot />
    <script>
      import "../scripts/smooth.js";
    </script>
  </body>
</html>
